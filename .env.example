# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# Both come from an active leetcode.com browser session — see the README
# ("Get your session cookies") for step-by-step instructions.
#
# ⚠️ Treat these like a password. `.env` is gitignored so it never gets
#    committed; keep it that way.

# The "LEETCODE_SESSION" cookie value (a long JWT).
LEETCODE_SESSION="your_leetcode_session_cookie_here"

# The "csrftoken" cookie value.
CSRF_TOKEN="your_csrf_token_here"
